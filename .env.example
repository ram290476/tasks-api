# Required values are intentionally blank: the app refuses to start without them.
NODE_ENV=development
PORT=3000

# Required. postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
DB_MIGRATIONS_RUN=true

# Required, min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=tasks-api
JWT_EXPIRES_IN_SECONDS=900

# Comma-separated allowed origins; leave blank to disable CORS.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (needed for correct client IPs).
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
